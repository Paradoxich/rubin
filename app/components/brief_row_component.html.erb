<article class="brief-row">
  <div class="brief-row__main">
    <h2 class="brief-row__title"><%= brief.title %></h2>

    <% if brief.body.present? %>
      <p class="brief-row__body"><%= truncate(brief.body, length: 140) %></p>
    <% end %>
  </div>

  <div class="brief-row__status" data-controller="dropdown">
    <button
      type="button"
      class="status-chip-trigger"
      data-action="dropdown#toggle"
      data-dropdown-target="button"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Change status"
    >
      <%= render StatusBadgeComponent.new(status: brief.status) %>
    </button>

    <div class="dropdown brief-row__status-menu" data-dropdown-target="menu" hidden>
      <% Brief::STATUSES.each do |status| %>
        <%= button_to brief_path(brief),
              method: :patch,
              params: { brief: { status: status } },
              class: class_names("dropdown__item", "is-active": brief.status == status),
              form: { data: { turbo_frame: "_top" } } do %>
          <%= render StatusBadgeComponent.new(status: status) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="brief-row__person" title="<%= brief.requester %>">
    <span class="brief-row__created-by type-body-sm">Created by</span>
    <%= render AvatarComponent.new(name: brief.requester) %>
    <span class="brief-row__hit-label"><%= brief.requester %></span>
  </div>

  <time
    class="brief-row__created type-body-sm"
    datetime="<%= brief.created_at.iso8601 %>"
    title="<%= l(brief.created_at, format: :long) %>"
  >
    <%= helpers.short_time_ago(brief.created_at) %>
  </time>

  <%= link_to edit_brief_path(brief),
        class: "brief-row__hit",
        aria: { label: "Edit #{brief.title}" } do %>
    <span class="brief-row__hit-label">Edit</span>
  <% end %>
</article>
