<% content_for :title, "Practice lab · Rubin" %>

<section class="page">
  <header class="page__header">
    <div>
      <h1 class="type-h1">Practice lab</h1>
      <p class="type-body page__lede">
        Same portfolio token layer, now driving a Hotwire surface: Turbo Frames,
        Turbo Streams, Stimulus, and ViewComponents.
      </p>
    </div>
  </header>

  <div class="brief-panel">
    <div class="brief-panel__header">
      <h2 class="type-h4 m-0">Briefs</h2>

      <div class="brief-panel__toolbar">
        <div class="filter-bar" data-controller="filter dropdown">
          <%= form_with url: briefs_path,
                method: :get,
                data: {
                  turbo_frame: "briefs",
                  filter_target: "form"
                } do |f| %>
            <%= f.hidden_field :status,
                  value: @status,
                  id: "status",
                  data: { filter_target: "field" } %>
          <% end %>

          <%# Rides along with the create form (HTML form attribute), so new
              briefs come back rendered into the currently filtered lane. %>
          <%= hidden_field_tag :status, @status,
                id: "brief_filter_status",
                form: "brief_form_new",
                data: { filter_target: "field" } %>

          <button
            type="button"
            class="<%= class_names("icon-button filter-bar__button", "is-active": @status.present?) %>"
            data-action="dropdown#toggle"
            data-dropdown-target="button"
            data-filter-target="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="<%= @status.present? ? "Filter by status (#{Brief.status_label(@status)})" : "Filter by status" %>"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2.5 3.5h11l-4 4.5v3.5L6.5 13V8L2.5 3.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="filter-bar__dot" aria-hidden="true"></span>
          </button>

          <div class="dropdown" data-dropdown-target="menu" hidden>
            <button
              type="button"
              class="<%= class_names("dropdown__item type-body-sm", "is-active": @status.blank?) %>"
              data-action="click->filter#select click->dropdown#close"
              data-status=""
            >All</button>

            <% Brief::STATUSES.each do |status| %>
              <button
                type="button"
                class="<%= class_names("dropdown__item type-body-sm", "is-active": @status == status) %>"
                data-action="click->filter#select click->dropdown#close"
                data-status="<%= status %>"
              ><%= Brief.status_label(status) %></button>
            <% end %>
          </div>
        </div>

        <%= link_to "Add brief",
              new_brief_path,
              class: "primary-button",
              data: { turbo_frame: "new_brief" } %>
      </div>
    </div>

    <%= render "briefs/new_brief_frame" %>

    <%= turbo_frame_tag "briefs", class: "brief-list" do %>
      <%= render "briefs/list", briefs: @briefs %>
    <% end %>
  </div>
</section>
