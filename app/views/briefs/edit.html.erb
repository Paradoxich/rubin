<% content_for :title, "Edit · #{@brief.title}" %>

<%= turbo_frame_tag @brief do %>
  <article class="brief-editor">
    <div class="brief-editor__top">
      <h2 class="type-h4" style="margin: 0">Edit brief</h2>
    </div>

    <%= render "form",
          brief: @brief,
          submit_label: "Save",
          cancel_path: brief_path(@brief) %>
  </article>
<% end %>
