<% content_for :title, "New brief · Rubin" %>

<%= turbo_frame_tag "new_brief" do %>
  <article class="brief-editor brief-editor--panel">
    <div class="brief-editor__top">
      <h2 class="type-h4" style="margin: 0">New brief</h2>
    </div>

    <%= render "form",
          brief: @brief,
          submit_label: "Add brief",
          cancel_path: new_brief_path(close: 1) %>
  </article>
<% end %>
