<%= form_with model: brief,
      class: "brief-editor__form",
      html: { id: brief.persisted? ? nil : "brief_form_new" } do |f| %>
  <% if brief.errors.any? %>
    <div class="form-errors" role="alert">
      <p><%= pluralize(brief.errors.count, "error") %> kept this from saving:</p>
      <ul>
        <% brief.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true, placeholder: "Homepage hero pass", autofocus: !brief.persisted? %>
  </div>

  <div class="field">
    <%= f.label :requester %>
    <%= f.text_field :requester, required: true, placeholder: "Maya Chen" %>
  </div>

  <div class="field">
    <%= f.label :body, "Notes" %>
    <%= f.text_area :body, rows: 4, placeholder: "What needs attention, constraints, links…" %>
  </div>

  <div class="field">
    <%= f.label :status %>
    <div class="status-field" data-controller="dropdown status-select">
      <%= f.hidden_field :status, data: { status_select_target: "field" } %>

      <button
        type="button"
        class="status-chip-trigger status-field__trigger"
        data-action="dropdown#toggle"
        data-dropdown-target="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Change status"
      >
        <span
          class="<%= class_names("badge", "type-body-sm", "status-field__badge", "badge--#{brief.status.presence || "inbox"}") %>"
          data-status-select-target="badge"
        >
          <span data-status-select-target="label"><%= Brief.status_label(brief.status.presence || "inbox") %></span>
          <svg class="status-field__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>

      <div class="dropdown status-field__menu" data-dropdown-target="menu" hidden>
        <% Brief::STATUSES.each do |status| %>
          <button
            type="button"
            class="<%= class_names("dropdown__item type-body-sm", "is-active": brief.status == status) %>"
            data-action="click->status-select#pick click->dropdown#close"
            data-status="<%= status %>"
          ><%= Brief.status_label(status) %></button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="brief-editor__actions">
    <% if local_assigns[:cancel_path] %>
      <%= link_to "Cancel", cancel_path, class: "ghost-button type-body-sm" %>
    <% else %>
      <button type="button" class="ghost-button type-body-sm" data-action="dismissable#dismiss">Cancel</button>
    <% end %>
    <%= f.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
