<%= form_with model: brief,
      class: "brief-editor__form",
      html: { id: brief.persisted? ? nil : "brief_form_new" } do |f| %>
  <% if brief.errors.any? %>
    <div class="form-errors" role="alert">
      <p><%= pluralize(brief.errors.count, "error") %> kept this from saving:</p>
      <ul>
        <% brief.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true, placeholder: "Homepage hero pass", autofocus: !brief.persisted? %>
  </div>

  <div class="field">
    <%= f.label :requester %>
    <%= f.text_field :requester, required: true, placeholder: "Maya Chen" %>
  </div>

  <div class="field">
    <%= f.label :body, "Notes" %>
    <%= f.text_area :body, rows: 4, placeholder: "What needs attention, constraints, links…" %>
  </div>

  <div class="field">
    <%= f.label :status %>
    <%= f.select :status, Brief::STATUSES.map { |s| [s.tr("_", " ").titleize, s] } %>
  </div>

  <div class="brief-editor__actions">
    <%= link_to "Cancel", cancel_path, class: "ghost-button type-body-sm" %>
    <%= f.submit submit_label, class: "primary-button" %>
  </div>
<% end %>
